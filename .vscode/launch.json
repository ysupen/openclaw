{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug OpenClaw Gateway",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "./dist/gateway.js"
      ],
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "openclaw:*"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Feishu Send Test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "args": ["${workspaceFolder}/scripts/test-feishu-send.ts"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    }
  ]
}
